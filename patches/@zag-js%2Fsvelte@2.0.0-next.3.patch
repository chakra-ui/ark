+export type StyleObject = Record<string, string | number | null | undefined>;
+/**
+ * Svelte replaces the whole `style` attribute when a spread style changes, which drops the properties machines
+ * write to the element directly (positioning variables, measured sizes). On the client, styles are applied
+ * through an attachment one property at a time instead, like the other frameworks do. The server keeps the
+ * style string, since attachments only run in the browser.
+ */
+export declare const STYLE_KEY: symbol;
+export declare const isServer: boolean;
+declare const STYLES: unique symbol;
+export declare function toCssNames(style: StyleObject): StyleObject;
+export declare function toStyleString(style: StyleObject): string;
+export declare function parseStyleString(style: string): StyleObject;
+export declare function createStyleAttachment(style: StyleObject): ((node: Element) => void) & {
+    [STYLES]: StyleObject;
+};
+export declare const getAttachedStyle: (value: unknown) => StyleObject | undefined;
+/** Puts a style where Svelte applies it: an attachment in the browser, the `style` attribute on the server */
+export declare function toStyleProps(style: StyleObject): {
+    style: string;
+} | {
+    [STYLE_KEY]: ((node: Element) => void) & {
+        [STYLES]: StyleObject;
+    };
+    style?: never;
+};
+export {};
