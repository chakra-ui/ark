{
  "name": "@ark-ui/website",
  "private": true,
  "scripts": {
    "prepare": "bun panda codegen",
    "generate:examples": "bun run --cwd ../scripts src/generate-example-registry.ts",
    "generate:changelogs": "node scripts/generate-changelogs.mjs",
    "predev": "bun run generate:examples && bun run generate:changelogs",
    "dev": "next dev --webpack",
    "prebuild": "bun run generate:examples && bun run generate:changelogs",
    "build": "next build --webpack",
    "start": "next start",
    "setup": "vc link --scope=chakra-ui -p ark-docs -y && vc env pull .env",
    "setup:prod": "vc link --scope=chakra-ui -p ark-docs -y && vc env pull --environment production .env"
  },
  "dependencies": {
    "@ark-ui/react": "workspace:*",
    "@biomejs/biome": "2.5.11",
    "@chakra-ui/better-auth": "0.3.0",
    "@icons-pack/react-simple-icons": "13.15.1",
    "@pandacss/dev": "2.0.0-beta.17",
    "@pandacss/preset-base": "2.0.0-beta.17",
    "@pandacss/preset-panda": "2.0.0-beta.17",
    "@pandacss/preset-typography": "2.0.0-beta.17",
    "@shikijs/langs": "4.4.3",
    "@shikijs/rehype": "4.4.3",
    "@shikijs/themes": "4.4.3",
    "@shikijs/transformers": "4.4.3",
    "@stackblitz/sdk": "1.11.1",
    "@types/node": "26.4.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@zag-js/anatomy-icons": "2.0.0-next.3",
    "@zag-js/docs": "2.0.0-next.3",
    "better-auth": "1.4.22",
    "effect": "3.22.1",
    "fumadocs-core": "16.15.11",
    "fumadocs-mdx": "15.4.1",
    "lucide-react": "1.37.0",
    "marked": "14.1.4",
    "match-sorter": "8.3.0",
    "next": "16.3.5",
    "next-themes": "0.4.6",
    "pg": "8.23.0",
    "postmark": "5.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-autolink-headings": "7.1.0",
    "rehype-slug": "6.0.0",
    "shiki": "4.4.3",
    "ts-morph": "28.0.0",
    "typescript": "6.0.3",
    "unist-util-visit": "5.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4"
  }
}
