{
  "Root": {
    "tag": "ark-qr-code",
    "props": {
      "value": {
        "type": "string",
        "isRequired": false,
        "description": "The controlled value to encode."
      },
      "default-value": {
        "type": "string",
        "isRequired": false,
        "description": "The initial value to encode when rendered.\nUse when you don't need to control the value of the qr code."
      },
      "pixel-size": {
        "type": "number",
        "isRequired": false,
        "description": "The pixel size of the qr code."
      },
      "error-correction": { "type": "string", "isRequired": false },
      "boost-ecc": { "type": "string", "isRequired": false },
      "border": { "type": "number", "isRequired": false },
      "mask-pattern": { "type": "number", "isRequired": false },
      "min-version": { "type": "number", "isRequired": false },
      "max-version": { "type": "number", "isRequired": false },
      "invert": { "type": "string", "isRequired": false },
      "dir": { "type": "string", "isRequired": false },
      "as-child": {
        "type": "boolean",
        "isRequired": false,
        "description": "Apply the props to the first child element instead of this element."
      },
      "debug": {
        "type": "boolean",
        "isRequired": false,
        "description": "Log state transitions, events and prop changes to the console. Applies to descendants too."
      }
    },
    "emits": {
      "valuechange": {
        "type": "CustomEvent<ValueChangeDetails & { source: InputSource; }>",
        "isRequired": false,
        "description": "Fired when the value changes."
      }
    },
    "properties": {
      "ids": {
        "type": "ElementIds",
        "isRequired": false,
        "description": "The element ids."
      },
      "value": {
        "type": "string",
        "isRequired": false,
        "description": "The controlled value to encode."
      },
      "ready": {
        "type": "Promise<void>",
        "isRequired": false,
        "description": "Resolves once the element's machine has started, so `api`, state and parts are in place."
      },
      "api": {
        "type": "QrCodeApi<PropTypes>",
        "isRequired": false,
        "description": "The Zag API of the component. `undefined` until it connects."
      }
    }
  },
  "DownloadTrigger": {
    "tag": "ark-qr-code-download-trigger",
    "props": {
      "file-name": {
        "type": "string",
        "isRequired": false,
        "description": "The name of the file."
      },
      "mime-type": {
        "type": "DataUrlType",
        "isRequired": false,
        "description": "The mime type of the image."
      },
      "quality": {
        "type": "number",
        "isRequired": false,
        "description": "The quality of the image."
      },
      "as-child": {
        "type": "boolean",
        "isRequired": false,
        "description": "Apply the props to the first child element instead of this element."
      },
      "for": {
        "type": "string",
        "isRequired": false,
        "description": "The id of the root this part belongs to, when it is not a descendant."
      }
    },
    "properties": {}
  },
  "Frame": {
    "tag": "ark-qr-code-frame",
    "props": {
      "as-child": {
        "type": "boolean",
        "isRequired": false,
        "description": "Apply the props to the first child element instead of this element."
      },
      "for": {
        "type": "string",
        "isRequired": false,
        "description": "The id of the root this part belongs to, when it is not a descendant."
      }
    },
    "properties": {}
  },
  "Overlay": {
    "tag": "ark-qr-code-overlay",
    "props": {
      "as-child": {
        "type": "boolean",
        "isRequired": false,
        "description": "Apply the props to the first child element instead of this element."
      },
      "for": {
        "type": "string",
        "isRequired": false,
        "description": "The id of the root this part belongs to, when it is not a descendant."
      }
    },
    "properties": {}
  },
  "Pattern": {
    "tag": "ark-qr-code-pattern",
    "props": {
      "as-child": {
        "type": "boolean",
        "isRequired": false,
        "description": "Apply the props to the first child element instead of this element."
      },
      "for": {
        "type": "string",
        "isRequired": false,
        "description": "The id of the root this part belongs to, when it is not a descendant."
      }
    },
    "properties": {}
  }
}
