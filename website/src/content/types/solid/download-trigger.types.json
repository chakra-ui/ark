{
  "DownloadTrigger": {
    "props": {
      "data": {
        "type": "DownloadableData | (() => MaybePromise<DownloadableData>)",
        "isRequired": true,
        "description": "The data to download"
      },
      "fileName": { "type": "string", "isRequired": true, "description": "The name of the file to download" },
      "mimeType": {
        "type": "FileMimeType",
        "isRequired": true,
        "description": "The MIME type of the data to download"
      },
      "asChild": {
        "type": "(props: PropsFn<'button'>) => Element",
        "isRequired": false,
        "description": "Use the provided child element as the default rendered element, combining their props and behavior.\n\nUse `render` when you need the part's state. It takes the same props function, plus the state."
      },
      "id": { "type": "string", "isRequired": false },
      "prop:command": { "type": "string | number", "isRequired": false },
      "prop:commandForElement": { "type": "Element", "isRequired": false },
      "prop:disabled": { "type": "boolean", "isRequired": false },
      "prop:formAction": { "type": "string | number", "isRequired": false },
      "prop:formEnctype": { "type": "string | number", "isRequired": false },
      "prop:formMethod": { "type": "string | number", "isRequired": false },
      "prop:formNoValidate": { "type": "boolean", "isRequired": false },
      "prop:formTarget": { "type": "string | number", "isRequired": false },
      "prop:name": { "type": "string | number", "isRequired": false },
      "prop:popoverTargetAction": { "type": "string | number", "isRequired": false },
      "prop:popoverTargetElement": { "type": "Element", "isRequired": false },
      "prop:type": { "type": "'button' | 'submit' | 'reset'", "isRequired": false },
      "prop:value": { "type": "string | number", "isRequired": false },
      "render": {
        "type": "RenderFn<'button', EmptyState>",
        "isRequired": false,
        "description": "Render the part as a custom element, combining their props and behavior.\n\nCall `props()` to spread the part's props, passing your own to merge them rather than overwrite them.\nThe state arrives as an accessor:\n`render={(props, state) => <button {...props({ onClick: mine })}>{state().open}</button>}`"
      }
    }
  }
}
