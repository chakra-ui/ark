{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "paths": {
      "styles/*": ["../../.storybook/modules/*"]
    }
  },
  "include": ["src", "examples", ".storybook", "../../.storybook/modules/css-modules.d.ts", "type-tests"]
}
