{
  "name": "@ark-ui/codemod",
  "version": "0.0.0",
  "description": "Codemods for migrating Ark UI codebases between versions.",
  "type": "module",
  "bin": {
    "ark-codemod": "./dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && chmod 755 dist/index.js",
    "dev": "tsup --watch",
    "lint": "biome lint ./src",
    "test": "vitest",
    "test:ci": "vitest --run",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@vue/compiler-sfc": "3.5.42",
    "commander": "14.0.3",
    "globby": "16.2.4",
    "magic-string": "1.2.3",
    "picocolors": "1.1.1",
    "svelte": "5.57.0",
    "ts-morph": "28.0.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.5",
    "@types/node": "26.4.0",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chakra-ui/ark",
    "directory": "packages/codemod"
  }
}
